"""Lightweight OpenCV dashboard."""
from __future__ import annotations

import cv2

from gestures.classifier import Gesture


class Dashboard:
    def __init__(self, window_name: str, debug: bool = False) -> None:
        self.window_name = window_name
        self.debug = debug
        self.last_action = "—"
        self.action_status = "WAITING"
        self._opened = False

    def create(self) -> None:
        cv2.namedWindow(self.window_name, cv2.WINDOW_NORMAL)
        cv2.resizeWindow(self.window_name, 960, 700)
        self._opened = True

    def render(self, frame, *, hand_detected: bool, handedness: str, gesture: Gesture, confidence: float, vlc_connected: bool, fps: float, inference_ms: float, state: str, debug_values: dict | None = None):
        canvas = frame.copy()
        if not self._opened:
            self.create()

        self._header(canvas, "GESTURE VLC CONTROLLER")
        self._text(canvas, f"Hand: {'Detected' if hand_detected else 'Waiting'}", 24, 55)
        self._text(canvas, f"Handedness: {handedness}", 24, 82)
        self._text(canvas, f"Gesture: {gesture.value}", 24, 109)
        self._text(canvas, f"Confidence: {confidence * 100:.0f}%", 24, 136)
        self._text(canvas, f"VLC: {'CONNECTED' if vlc_connected else 'NOT CONNECTED'}", 24, 163)
        self._text(canvas, f"Current Action: {self.last_action}", 24, 190)
        self._text(canvas, f"Status: {self.action_status}", 24, 217)
        self._text(canvas, f"FPS: {fps:.1f}", 24, 244)
        self._text(canvas, f"Inference: {inference_ms:.1f} ms", 24, 271)
        self._text(canvas, f"State: {state}", 24, 298)

        if self.debug and debug_values:
            y = 330
            for key, value in debug_values.items():
                self._text(canvas, f"{key}: {value}", 24, y, size=0.48)
                y += 20

        cv2.rectangle(canvas, (8, 8), (canvas.shape[1] - 8, canvas.shape[0] - 8), (90, 90, 90), 1)
        cv2.putText(canvas, "Q / ESC: quit", (canvas.shape[1] - 150, canvas.shape[0] - 18), cv2.FONT_HERSHEY_SIMPLEX, 0.42, (190, 190, 190), 1, cv2.LINE_AA)
        return canvas

    def _header(self, image, text: str) -> None:
        cv2.putText(image, text, (24, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.78, (255, 255, 255), 2, cv2.LINE_AA)

    def _text(self, image, text: str, x: int, y: int, size: float = 0.52) -> None:
        cv2.putText(image, text, (x, y), cv2.FONT_HERSHEY_SIMPLEX, size, (235, 235, 235), 1, cv2.LINE_AA)

    def close(self) -> None:
        if self._opened:
            cv2.destroyWindow(self.window_name)
            self._opened = False
